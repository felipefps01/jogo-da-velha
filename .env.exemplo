# Copie este arquivo para .env e preencha com seus valores.
# No Netlify, cadastre as mesmas chaves em Site settings → Environment variables.

# Chave da API do Google Gemini (obrigatória para geração).
GEMINI_API_KEY=

# Chave da OpenRouter (reserva automática, caso a chave Gemini falhe/esteja ausente).
OPENROUTER_API_KEY=

# Senha do editor do System Prompt Permanente (nunca colocada no frontend).
SENHA_PROMPT=
